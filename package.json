{
  "name": "mundo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mundo — jogo de geografia: bandeiras, capitais e mapa-múndi",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts && tsx scripts/build-map.ts && tsx scripts/build-flags.ts",
    "dev": "vite",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "deploy": "npm run check:deploy && npm run build && wrangler deploy",
    "build:icons": "tsx scripts/build-icons.ts",
    "e2e": "node e2e/play-through.mjs",
    "setup:cloudflare": "tsx scripts/setup-cloudflare.ts",
    "check:deploy": "tsx scripts/check-deploy-config.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "flag-icons": "^7.5.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "wrangler": "^4.136.1"
  }
}
